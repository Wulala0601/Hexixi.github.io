  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc -b && vite build --configLoader native && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
